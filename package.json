{
  "name": "vscode-acp-workspace",
  "private": true,
  "workspaces": [
    "acp-pipeline",
    "acp-runtime",
    "acp-sandcastle",
    "acp-workspace",
    "pipeline-cli",
    "plugin-vscode",
    "plugin-pi"
  ],
  "scripts": {
    "compile": "npm run compile -w acp-client",
    "clean": "npm run clean -w acp-client --",
    "watch": "npm run watch -w acp-client",
    "package": "npm run package -w acp-client",
    "test": "npm run test:common && npm run test:vscode && npm run test:pi && npm run test:cli",
    "test:common": "npm run test -w @acp-client/pipeline && npm run test -w @acp-client/sandcastle && npm run test -w @acp-client/runtime && npm run test -w @acp-client/workspace",
    "test:vscode": "npm run test -w acp-client",
    "lint": "npm run lint -w acp-client",
    "compile-tests": "npm run compile-tests -w acp-client",
    "test:pi": "npm run test -w @acp-client/pi-extension",
    "build:cli": "npm --prefix pipeline-cli run build",
    "test:cli": "npm --prefix pipeline-cli test",
    "test:cli:pipeline": "npm run acp-cli -- run grill-spec-tickets-implement-review",
    "acp-cli": "npm run build:cli && node pipeline-cli/dist/src/cli.js",
    "vsx": "npm run vsx -w acp-client"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
