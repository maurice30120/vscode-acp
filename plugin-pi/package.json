{
  "name": "@acp-client/pi-extension",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    },
    "./host": {
      "types": "./dist/src/host.d.ts",
      "import": "./dist/src/host.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "npm run build -w @acp-client/workspace && tsc -p tsconfig.json --incremental false",
    "test": "npm run build && node --test \"dist/test/**/*.test.js\"",
    "clean": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\"",
    "pi:install": "npm install && npm run build && pi install .",
    "pi:smoke": "cd .. && pi -ne -e ./plugin-pi/dist/src/index.js --no-builtin-tools -p \"reply with exactly: SMOKE_OK\"",
    "pi": "npm run pi:install && npm run pi:smoke"
  },
  "dependencies": {
    "@acp-client/pipeline": "file:../acp-pipeline",
    "@acp-client/runtime": "file:../acp-runtime",
    "@acp-client/sandcastle": "file:../acp-sandcastle",
    "@acp-client/workspace": "file:../acp-workspace",
    "@agentclientprotocol/sdk": "^0.21.1",
    "@earendil-works/pi-coding-agent": "^0.80.3",
    "typebox": "^1.3.5"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
