{
  "Codex CLI": {
    "command": "npx",
    "args": [
      "@zed-industries/codex-acp@latest"
    ],
    "env": {}
  },
  "Vibe": {
    "command": "vibe-acp",
    "args": [],
    "env": {}
  },
  "Cursor CLI": {
    "command": "agent",
    "args": [
      "acp"
    ],
    "env": {}
  },
  "Codex Sandcastle": {
    "transport": "sandcastle",
    "provider": "codex",
    "model": "gpt-5.4",
    "effort": "high",
    "env": {}
  },
  "Cursor Sandcastle": {
    "transport": "sandcastle",
    "provider": "cursor",
    "model": "composer-2",
    "env": {}
  },
  "Pi Sandcastle": {
    "transport": "sandcastle",
    "provider": "pi",
    "model": "claude-sonnet-4-6",
    "effort": "high",
    "env": {}
  },
  "OpenCode": {
    "command": "npx",
    "args": [
      "opencode-ai@latest",
      "acp"
    ],
    "env": {}
  },
  "Pi Agent": {
    "command": "npx",
    "args": [
      "-y",
      "pi-acp"
    ],
    "env": {}
  }
}
